# ---------------------------------------------------------------------------
# India News Bot configuration.
# Copy to `.env` and fill in. `.env` is gitignored - never commit real keys.
# ---------------------------------------------------------------------------

# --- Telegram (required) ---------------------------------------------------
# 1. Message @BotFather -> /newbot -> copy the token here.
TELEGRAM_BOT_TOKEN=
# Your channel, e.g. @my_india_news (public) or -1001234567890 (private).
TELEGRAM_FREE_CHANNEL=
# Premium channel (Phase 2, optional).
# TELEGRAM_PREMIUM_CHANNEL=
# Your own Telegram user id (message @userinfobot). Enables /stats and /collect.
# ADMIN_USER_ID=

# --- LLM -------------------------------------------------------------------
# DeepSeek: create a key at https://platform.deepseek.com -> API keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Want a fully local LLM instead (per the original plan)? Install Ollama,
# `ollama pull qwen3:4b`, then use these values. Any non-empty key works.
# DEEPSEEK_BASE_URL=http://localhost:11434/v1
# DEEPSEEK_MODEL=qwen3:4b
# DEEPSEEK_API_KEY=ollama

# Force the offline heuristic "mock" analysis (no API key needed). Useful to
# test the pipeline without spending anything.
# LLM_MOCK=1

# Summary language: en (English) | hi (Hindi) | both (English + Hindi line)
SUMMARY_LANGUAGE=en

# --- Behaviour ---------------------------------------------------------------
# How often new articles are collected and analyzed.
COLLECT_INTERVAL_MINUTES=15
# Paced posting: one story every N minutes (keeps the channel steadily active
# for subscribers; a skipped slot simply means nothing was pending).
PUBLISH_INTERVAL_MINUTES=5
# Safety cap on posts per rolling 24 hours (the spacing usually hits first).
FREE_DAILY_CAP=300
# Max entries taken from each RSS feed per cycle.
MAX_ARTICLES_PER_FEED=15
# Duplicate detection: window + fuzzy-title similarity threshold (0-1).
DEDUPE_WINDOW_HOURS=72
DEDUPE_THRESHOLD=0.87
# Only publish stories this fresh (breaking news ordering still applies).
MAX_ARTICLE_AGE_HOURS=48
# Footer line appended to every channel post.
# POST_FOOTER=Published automatically by IndiaNewsBot

# --- Premium tier: exclusive content, ₹25/month via Telegram Stars -----------
# 1. Create a PRIVATE channel + add the bot as admin:
#    Post messages + Pin messages + Invite users via link
# 2. Set the channel id here (numeric -100... or @username), then run:
#    premium_setup.bat  ->  creates the monthly Stars subscription link
# TELEGRAM_PREMIUM_CHANNEL=-1001234567890
# PREMIUM_PRICE_STARS=15              # ~₹25/month (Stars cost ~₹1.5-2 each)
# PREMIUM_PUBLISH_INTERVAL_MINUTES=5  # premium full-feed pacing
# PREMIUM_PUBLISH_BATCH=5             # stories per tick (premium = everything)
# PREMIUM_INVITE_LINK=                # auto-filled by the setup script

# --- Optional integrations ---------------------------------------------------
# X API (paid tier required): https://developer.x.com
# X_BEARER_TOKEN=

# Files (defaults shown; only set to override)
# DB_PATH=newsbot.db
# FEEDS_FILE=feeds.yaml

# Logging
# LOG_LEVEL=INFO
